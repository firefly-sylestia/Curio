[TEMPLATE]
# ─────────────────────────────────────────────────────────────────────────────
# Curio environment example
# ─────────────────────────────────────────────────────────────────────────────
#
# Copy what you need into your local shell (or into the repo's
# Settings > Secrets and variables > Actions) — NEVER commit real values.
#
# The app BUILDS AND RUNS WITH NONE OF THIS SET. Every one of the boxes below
# turns a *keyed upgrade* on; nothing here is required for the sheets, the
# readers or the topic reveal to work.
#
# ── WHAT THE ARTWORK / CHAPTER / AUTHOR SHEETS READ ──────────────────────────
#
# Every sheet is fed by keyless sources by default. This is the honest map of
# them, with the free tier each one actually enforces, so a key can be added
# where it buys something real:
#
#   Open Library        keyless · openlibrary.org
#     Book data, chapter/title lookups, covers, and the AUTHOR sheet's
#     "written works" list. No key, ever. Generous but slow on cold cache —
#     the app caches resolved art per topic (AppPreferences.sheetArtUrlsState)
#     so a revisit never re-asks.  →  no env var
#
#   Google Books        OPTIONAL key · googleapis.com/books/v1
#     Chapters (volumeInfo.tableOfContents) as the FALLBACK when Open Library
#     has no table of contents, plus covers + ratings. Keyless works with a
#     small daily quota; a free key raises it. Never required for a lookup to
#     succeed.  →  GOOGLE_BOOKS_API_KEY   free: 1,000 queries/day
#        https://developers.google.com/books/docs/v1/using#APIKey
#
#   iTunes Search       keyless · itunes.apple.com/search
#     Film / anime / song artwork, and Apple Music deep links. No key.
#     ~20 requests/minute per IP — the app only asks on a cache miss.
#     →  no env var
#
#   TVMaze              keyless · api.tvmaze.com
#     Series + film posters (singlesearch/shows), and the episode list that
#     tells a film-shaped topic it is really a show. No key, ~20 calls/10s.
#     →  no env var
#
#   TMDB                OPTIONAL key · api.themoviedb.org/3
#     The keyed upgrade for film and anime artwork (image.tmdb.org posters),
#     the facts a film sheet can show about a film (year, runtime, rating,
#     genres, director, top-billed cast) and the seasons/episodes of a title
#     that maps to a show. FREE for personal use; a key is required for every
#     call, so without it these rows simply do not appear — the keyless
#     providers (iTunes, TVMaze, Jikan) keep answering exactly as before.
#     The key travels as the `api_key` query parameter; no user login, no
#     server of ours in the middle.  →  TMDB_API_KEY   free (no card)
#        https://developer.themoviedb.org/docs/getting-started
#        GitHub Actions: repo Settings > Secrets and variables > Actions >
#        New repository secret > name it TMDB_API_KEY (see .github/AGENTS.md).
#
#   AniList             keyless · graphql.anilist.co
#     Manga / manhwa / manhua / light-novel covers, authors, synopses, volumes
#     and chapter counts — the widest cover set of the comics sources, and the
#     only one that knows a light novel is a NOVEL rather than a comic.
#     →  no env var
#
#   MangaDex            keyless · api.mangadex.org
#     Where a scanlation lives, so it answers for series the other catalogues
#     have never heard of. No key.
#     →  no env var
#
#   Kitsu               keyless · kitsu.io/api/edge
#     A last, generous comics fallback. No key.
#     →  no env var
#
#   Standard Ebooks     keyless · standardebooks.org/feeds/opds
#     Public-domain classics — a real cover, a one-line summary and a blurb for
#     a book whose catalogue entry has no artwork. An Atom feed with
#     ?query=<words>&per-page=<n>; no key, and it asks for nothing back.
#     →  no env var
#
#   Comic Vine          OPTIONAL key · comicvine.gamespot.com/api
#     WESTERN COMICS — the door that actually answers for them: it holds
#     Marvel's and DC's volumes both, with the cover, the publisher, the year
#     and how many issues a volume runs to. Asked FIRST for a Comic and LAST
#     for a manga. Free for non-commercial use, 1 request/second and 200 per
#     resource per hour, so the app asks once per row.
#       NOTE: Marvel's own developer API was DISCONTINUED (its keys answered
#       nothing by 2026) and DC never published one — so there is no Marvel or
#       DC key to add, and Comic Vine is both publishers' door.
#     →  COMIC_VINE_API_KEY   free
#        https://comicvine.gamespot.com/api/
#
#   Jikan               keyless · api.jikan.moe/v4   (MyAnimeList data)
#     Anime posters + episode counts, and MANGA search (it is the same
#     database). No key. 3 requests/second, 60/minute.
#     →  no env var
#
#   MusicBrainz         keyless · musicbrainz.org/ws/2
#     Album / artist / release-group data for the ALBUM sheet, and the bridge
#     from an album to Cover Art Archive artwork. No key, but a POLITE limit of
#     1 request/second and a real User-Agent (the app sends its own).
#     →  no env var
#
#   Cover Art Archive   keyless · coverartarchive.org
#     Album covers by MusicBrainz release id. No key.
#     →  no env var
#
#   LibraryThing        OPTIONAL key · covers.librarything.com
#     ISBN-based book covers — the one provider that HIDES ITS ROW when the key
#     is absent, because its endpoint requires it. Everything else still
#     resolves without it.  →  LIBRARY_THING_API_KEY   free for devs
#        https://www.librarything.com/services/keys.php
#
#   Spotify             OPTIONAL id+secret · Web API
#     Turns an album/track/artist into a REAL open.spotify.com deep link via
#     the client-credentials flow (no user login). Unset = Spotify keeps using
#     search links, which still open the right thing.  →  SPOTIFY_CLIENT_ID +
#        SPOTIFY_CLIENT_SECRET   free, no card
#        https://developer.spotify.com/dashboard
#
# Want a source that is not on this list (Discogs for pressings, CrossRef for
# papers, AniList for anime lists)? Add it WITH its key wiring in
# app/build.gradle.kts — a key alone does nothing, because every provider is an
# explicit fetcher (see features/reveal/*Fetch.kt, features/personal/BookEnrichment.kt).
# TMDB is the worked example of that whole path: an env var + a buildConfigField
# in app/build.gradle.kts, an env entry in BOTH workflows, a fetcher under
# features/reveal/, and a row in this map.
#
# ─────────────────────────────────────────────────────────────────────────────

# ── Optional keys (each one upgrades its provider; blank is a working app) ───

# Google Books — chapters fallback + covers/ratings. Free: 1,000/day.
GOOGLE_BOOKS_API_KEY=

# LibraryThing — ISBN cover provider (its row stays hidden while unset).
LIBRARY_THING_API_KEY=

# Comic Vine — Western comics (Marvel and DC volumes both). No key = the
# keyless comics sources keep doing the work and no Comic Vine request is made.
COMIC_VINE_API_KEY=

# Spotify — real album/track deep links (search links are used while unset).
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

# TMDB — film/anime artwork, a film's facts, and a show's episode list.
# Read the note in the source map above before expecting it: with no key the
# film and anime sheets keep their keyless providers, and no TMDB row appears.
TMDB_API_KEY=

# ── Online accounts (the app's Supabase backend) ─────────────────────────────
# These are the values the shipped APK already carries: the project URL and the
# PUBLISHABLE (anon) key, protected by row-level security. The service-role key
# must NEVER be set here — it belongs to auth-web/ alone.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
# Where account emails land (auth-web/, e.g. https://curio-accounts.vercel.app).
# Unset = no redirect is sent and the sign-in form hides its password-recovery
# row, so a build without the site behaves exactly as it did before.
CURIO_AUTH_SITE_URL=

# ── Release signing (Android CI only — never needed to build locally) ────────
# KEYSTORE_BASE64=
# KEYSTORE_PASSWORD=
# KEY_ALIAS=
# KEY_PASSWORD=
