# IDX workspace files stay local — except the toolchain, which is tracked on
# its own. (The pattern is `.idx/*` rather than `.idx/` because git cannot
# re-include a file whose parent DIRECTORY is excluded.)
.idx/*
!.idx/dev.nix
.vscode/
node_modules/
node_modules
.env

# Agent-tool shims written the first time `npx skills` runs. The skills
# themselves live in .agents/skills/ (tracked) with skills-lock.json; these are
# per-tool copies and links, so they are regenerated rather than committed.
/.claude/
/agent/
/data/skills/
./release-key.jks

# Python
__pycache__/
*.pyc
/result

# Authoring/validation scripts — kept on disk for local work but never
# shipped in commits (user preference). CI validation uses the self-contained
# Gradle validateTopics task instead (see app/build.gradle.kts).
/scripts/*.py
/scripts/*.js

# Web app (separate React project, not part of Android build)
/web/dist
/web/.vite

# Generated UI-texts reference (extraction tool: tools/extract_app_texts.py)
/app-texts.md

# Working analysis / product roadmap doc — intentionally NOT committed or
# pushed (see the header of ANALYSIS.md itself). Kept on disk for local work.
/ANALYSIS.md
