# Curio account site (auth-web) — environment example.
#
# Copy these into the Vercel project's Environment Variables (Production and
# Preview). Nothing here is read by the static pages directly: they call
# /api/config, which reads these server-side, so no key is ever committed.

# The Supabase project URL, the same value the Android build uses.
SUPABASE_URL=

# The publishable (anon) key. SUPABASE_PUBLISHABLE_KEY is accepted as an alias.
SUPABASE_ANON_KEY=

# SERVER ONLY. Used by /api/delete-account to remove an account. Never exposed
# to the browser, never sent to /api/config.
SUPABASE_SERVICE_ROLE_KEY=

# Published on /support and /privacy as the contact address.
SUPPORT_EMAIL=

# The "Get Curio" link. Defaults to the latest GitHub release.
# APP_DOWNLOAD_URL=

# Shown in the header, page titles and emails-facing copy.
# SITE_NAME=Curio
