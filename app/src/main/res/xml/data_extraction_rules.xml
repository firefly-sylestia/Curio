<?xml version="1.0" encoding="utf-8"?>
<!--
    Curio Auto Backup rules — Android 12+ (targetSdk 31+).

    The uninstall/reinstall "keep my data" behavior comes from Auto Backup:
    with allowBackup=true the system uploads the data below to Google Drive
    and restores it on reinstall/device setup.

    Because <include> restricts the backup to ONLY the named domains, the
    `files/` domain is left out — audio recordings (filesDir/audio) and
    session screenshots (filesDir/session-shots) are large and would blow
    the 25 MB per-app cloud quota, which would silently disable ALL cloud
    backup. Captures + settings are tiny text, and both media kinds ride
    the in-app file backup (the complete archive).

    Crash logs (curio_crash_logs) are device noise, not user data, so they
    are excluded; <exclude> takes precedence over <include>.
-->
<data-extraction-rules>
    <cloud-backup>
        <include domain="database" path="." />
        <include domain="sharedpref" path="." />
        <exclude domain="sharedpref" path="curio_crash_logs.xml" />
        <!-- Account session (access + refresh tokens) never rides a cloud
             backup or a device transfer: a refresh token in Drive would
             outlive the device it was issued to. Signing in again after a
             reinstall/device setup is the intended cost. -->
        <exclude domain="sharedpref" path="curio_supabase_session.xml" />
    </cloud-backup>
    <device-transfer>
        <include domain="database" path="." />
        <include domain="sharedpref" path="." />
        <exclude domain="sharedpref" path="curio_crash_logs.xml" />
        <exclude domain="sharedpref" path="curio_supabase_session.xml" />
    </device-transfer>
</data-extraction-rules>
