<?xml version="1.0" encoding="utf-8"?>
<!-- v271 — REAL liquid-glass widget on Samsung One UI 7+ launchers:
     the ROOT view must be @android:id/background with a 1..254-alpha
     background — One UI Home then captures + blurs the wallpaper region
     behind the widget and draws it under our #66FFFFFF tint. On non-Samsung
     launchers the tile degrades gracefully to a translucent pane (the inner
     rim keeps it defined). -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@android:id/background"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#66FFFFFF">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="18dp"
        android:paddingEnd="18dp">

        <TextView
            android:id="@+id/glass_widget_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/glass_widget_title"
            android:textColor="#FFFFFF"
            android:textSize="17sp"
            android:textStyle="bold"
            android:shadowColor="#66000000"
            android:shadowDy="1.5"
            android:shadowRadius="3" />

        <TextView
            android:id="@+id/glass_widget_stats"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="#F2FFFFFF"
            android:textSize="13sp"
            android:shadowColor="#66000000"
            android:shadowDy="1.5"
            android:shadowRadius="3" />
    </LinearLayout>
</FrameLayout>
