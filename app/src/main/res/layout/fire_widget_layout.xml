<?xml version="1.0" encoding="utf-8"?>
<!-- v292 — fire (streak) widget: flame glyph + count on a round frost
     tile. Plain translucent root color for One UI's wallpaper-blur
     detection; the provider clips it to a circle via outline radius. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@android:id/background"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#66FFFFFF">

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:orientation="vertical"
        android:gravity="center">

        <ImageView
            android:id="@+id/fire_widget_icon"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:importantForAccessibility="no" />

        <TextView
            android:id="@+id/fire_widget_count"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="0"
            android:textColor="#FFFFFF"
            android:textSize="18sp"
            android:textStyle="bold"
            android:maxLines="1"
            android:shadowColor="#66000000"
            android:shadowDy="1.5"
            android:shadowRadius="3" />
    </LinearLayout>
</FrameLayout>
