<?xml version="1.0" encoding="utf-8"?>
<!-- v272 — DARK frost variant for the glass widget: smoky pane with a
     soft light rim, same rounded corners and depth base as the light
     version. All layers stay translucent (alpha < 255) so One UI's
     wallpaper-blur detection (root background alpha 1..254) still fires. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Drop shadow / depth base -->
    <item android:top="2dp">
        <shape android:shape="rectangle">
            <corners android:radius="28dp" />
            <solid android:color="#33000000" />
        </shape>
    </item>
    <!-- Smoky frost body: darker top → deepest bottom, lit rim -->
    <item android:bottom="2dp">
        <shape android:shape="rectangle">
            <corners android:radius="28dp" />
            <gradient
                android:angle="270"
                android:startColor="#73232430"
                android:centerColor="#661A1B24"
                android:endColor="#99101118" />
            <stroke
                android:width="1.5dp"
                android:color="#8CFFFFFF" />
        </shape>
    </item>
</layer-list>
