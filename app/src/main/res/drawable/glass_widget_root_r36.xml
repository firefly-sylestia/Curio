<?xml version="1.0" encoding="utf-8"?>
<!-- v285 - rounded translucent root tint for NON-Samsung launchers (no One
     UI blur to preserve there). Samsung keeps the plain color background
     its wallpaper-blur detection requires; see GlassWidgetProvider. -->
