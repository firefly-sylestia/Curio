<?xml version="1.0" encoding="utf-8"?>
<!-- v274 — the widget ROOT's own background is now a NEAR-INVISIBLE rounded
     tint: its only job is to satisfy One UI Home's wallpaper-blur detection
     (root background must have alpha 1..254) while staying out of the way.
     The visible pane is rendered programmatically per-widget into the
     glass_widget_pane ImageView (see GlassWidgetPane). -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="28dp" />
            <solid android:color="#17FFFFFF" />
        </shape>
    </item>
</layer-list>
