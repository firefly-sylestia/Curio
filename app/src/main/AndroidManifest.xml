<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Update checker: queries the public GitHub API for the latest release (About → Check for updates). -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- v25 — in-app updater: lets the user install the downloaded release APK. -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <!-- Floating explore bubble: a Messenger-style timer bubble drawn over
         other apps (the browser) while an explore session runs. This is a
         special-access permission granted via Settings (no runtime dialog). -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
    <!-- Explore-session timer: persistent elapsed-time notification + done reminder -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <!-- v272 — Glass Widget Lab auto-detect: reading the system wallpaper on
         Android 13+ is gated behind All-files access (a Settings-page special
         permission, requested only from the lab's own opt-in button). -->
    <uses-permission
        android:name="android.permission.MANAGE_EXTERNAL_STORAGE"
        tools:ignore="ScopedStorage" />

    <!-- Android 11+ package visibility: without this, resolveActivity() /
         queryIntentActivities() return nothing for OTHER apps' activities,
         which broke external launches like the bug-report "Report on GitHub"
         button (it silently skipped the browser). Declaring the VIEW
         intent for web URLs makes browser launches visible and checkable. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="https" />
        </intent>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="http" />
        </intent>
    </queries>

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:networkSecurityConfig="@xml/network_security_config"
        android:supportsRtl="true"
        android:theme="@style/Theme.Curio"
        android:usesCleartextTraffic="false">

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

        <receiver
            android:name=".infrastructure.DailyReminderReceiver"
            android:exported="false" />

        <receiver
            android:name=".infrastructure.DailyReminderBootReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.TIME_SET" />
                <action android:name="android.intent.action.TIMEZONE_CHANGED" />
            </intent-filter>
        </receiver>

        <!-- Explore sessions: elapsed-timer foreground notification + "are
             you done?" reminder, rebuilt after reboot so a session never
             silently dies in the background. -->
        <service
            android:name=".infrastructure.ExploreSessionService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="exploreSessionTimer" />
        </service>

        <!-- v256 — the pet companion OUTSIDE the app: a tiny overlay window
             that keeps the sprite floating over other apps (opt-in). -->
        <service
            android:name=".infrastructure.PetOverlayService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="petCompanionOverlay" />
        </service>

        <receiver
            android:name=".infrastructure.ExploreReminderReceiver"
            android:exported="false" />

        <receiver
            android:name=".infrastructure.ExploreBootReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
                <action android:name="android.intent.action.TIME_SET" />
                <action android:name="android.intent.action.TIMEZONE_CHANGED" />
            </intent-filter>
        </receiver>

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:icon="@mipmap/ic_launcher"
            android:label="@string/app_name"
            android:theme="@style/Theme.Curio">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- v272 — glass widget configuration (placement + long-press Edit) -->
        <activity
            android:name=".infrastructure.GlassWidgetConfigActivity"
            android:exported="false"
            android:theme="@style/Theme.Curio">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_CONFIGURE" />
            </intent-filter>
        </activity>

        <!-- v279 — Glass Widget Lab live wallpaper -->
        <service
            android:name=".infrastructure.GlassLabWallpaperService"
            android:exported="true"
            android:permission="android.permission.BIND_WALLPAPER">
            <intent-filter>
                <action android:name="android.service.wallpaper.WallpaperService" />
            </intent-filter>
            <meta-data
                android:name="android.service.wallpaper"
                android:resource="@xml/glass_lab_wallpaper" />
        </service>

        <!-- v267 — the liquid-glass home-screen widget -->
        <receiver
            android:name=".infrastructure.GlassWidgetProvider"
            android:exported="false">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/glass_widget_info" />
        </receiver>

        <!-- v292 — round analog clock widget (Glass Widget Lab shape) -->
        <receiver
            android:name=".infrastructure.AnalogClockWidgetProvider"
            android:exported="false">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/glass_analog_clock_info" />
        </receiver>

        <!-- v292 — fire (streak) widget (Glass Widget Lab shape) -->
        <receiver
            android:name=".infrastructure.FireWidgetProvider"
            android:exported="false">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/fire_widget_info" />
        </receiver>
    </application>

</manifest>
